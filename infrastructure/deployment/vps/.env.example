POSTGRES_DB=market_genome
POSTGRES_USER=market_genome
POSTGRES_PASSWORD=replace_with_strong_password
MARKET_GENOME_DATABASE_URL=postgresql+psycopg://market_genome:replace_with_strong_password@postgres:5432/market_genome
MARKET_GENOME_REDIS_URL=redis://redis:6379/0
MARKET_GENOME_DATA_ROOT=/opt/market-genome/data
MARKET_GENOME_REPORT_ROOT=/opt/market-genome/reports
MARKET_GENOME_LOG_ROOT=/opt/market-genome/logs
MARKET_GENOME_BACKUP_ROOT=/opt/market-genome/data/backups
MARKET_GENOME_POSTGRES_ROOT=/opt/market-genome/data/postgres
MARKET_GENOME_REDIS_ROOT=/opt/market-genome/data/redis
MARKET_GENOME_LOG_LEVEL=INFO
MARKET_GENOME_API_BIND=127.0.0.1:8000
